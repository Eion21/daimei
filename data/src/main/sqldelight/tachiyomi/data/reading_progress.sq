import kotlin.Int;
import kotlin.time.Instant;

CREATE TABLE reading_progress(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    block_index INTEGER AS Int NOT NULL,
    block_offset_px INTEGER AS Int NOT NULL,
    block_fraction REAL NOT NULL,
    percent REAL NOT NULL,
    state_date_update INTEGER AS Instant NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapter(id) ON DELETE CASCADE
);

getByChapterId:
SELECT chapter_id, block_index, block_offset_px, block_fraction, percent, state_date_update FROM reading_progress WHERE chapter_id = :chapterId;

upsert:
INSERT INTO reading_progress(chapter_id, block_index, block_offset_px, block_fraction, percent, state_date_update)
VALUES (:chapterId, :blockIndex, :blockOffsetPx, :blockFraction, :percent, :stateDateUpdate)
ON CONFLICT(chapter_id) DO UPDATE SET
    block_index = excluded.block_index,
    block_offset_px = excluded.block_offset_px,
    block_fraction = excluded.block_fraction,
    percent = excluded.percent,
    state_date_update = excluded.state_date_update;

delete:
DELETE FROM reading_progress WHERE chapter_id = :chapterId;

-- One row per chapter that has a saved position, keyed by chapter id, for a single manga. The join goes through
-- `chapter` rather than reading the progress table whole, so the chapter list costs one query instead of one per
-- chapter, and a manga whose chapters are all images returns nothing at all.
getPercentByMangaId:
SELECT chapter.id, reading_progress.percent
FROM reading_progress
INNER JOIN chapter ON chapter.id = reading_progress.chapter_id
WHERE chapter.manga_id = :mangaId;