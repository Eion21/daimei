import kotlin.Int;
import kotlin.time.Instant;

CREATE TABLE chapter_content(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    file_path TEXT NOT NULL,
    state_date_download INTEGER AS Instant NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapter(id) ON DELETE CASCADE
);

CREATE TABLE reading_progress(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    block_index INTEGER AS Int NOT NULL,
    block_offset_px INTEGER AS Int NOT NULL,
    percent REAL NOT NULL,
    state_date_update INTEGER AS Instant NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES chapter(id) ON DELETE CASCADE
);
